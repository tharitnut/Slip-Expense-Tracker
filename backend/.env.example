# Environment mode: 'development' or 'production'
# In production, the server strictly refuses to boot if SECRET_KEY uses any dev default.
ENV=development

# Database Connection URL:
# Local dev: sqlite:///./dev.db
# Production / Neon: postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./dev.db

# JWT signing secret key:
# For production, generate a long random secret:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# JWT token expiration in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS origins (comma-separated, without trailing slashes)
# In production, specify your exact Vercel frontend URL:
# CORS_ORIGINS=https://slip-expense-tracker.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000
